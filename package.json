{
  "name": "pageslens",
  "version": "0.0.0",
  "description": "Offline lint and docs for Power Pages site configuration in source control",
  "keywords": [
    "cli",
    "dataverse",
    "lint",
    "power-pages",
    "power-platform",
    "table-permissions"
  ],
  "license": "MIT",
  "author": "Oleksandr Olashyn (dancingwithcrm)",
  "bin": {
    "pageslens": "dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "prepublishOnly": "vp check && vp test && vp pack"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vite-plus": "^1.3.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
